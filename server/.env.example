# Server Port (automatically assigned by Render in production)
PORT=5000

# MongoDB Connection String
# Local development:
MONGODB_URI=mongodb://127.0.0.1:27017/codeme
# Production (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/codeme?retryWrites=true&w=majority

# Allowed Frontend Origin(s) for CORS (comma-separated if multiple)
# Local development:
CLIENT_URL=http://localhost:5173
# Production (Vercel deployment):
# CLIENT_URL=https://your-codeme-app.vercel.app

# AI Learning Assistant configuration (Google Gemini)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
AI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_PROVIDER=gemini

# Optional API base URL override (uses default Google Generative Language endpoint when omitted)
# AI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent
