MONGODB_URI=mongodb://127.0.0.1:27017/codeme
CLIENT_URL=http://localhost:5173

# AI Learning Assistant configuration (Google Gemini)
AI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_PROVIDER=gemini
